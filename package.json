{
  "name": "@zixcel/webauthn",
  "version": "0.10.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Browser WebAuthn options and binary evidence for an explicit authenticator profile",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "!**/*.tgz"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs"
    }
  },
  "scripts": {
    "test": "npm run build && node --test test/*.test.mts",
    "test:browser": "npm run build && playwright test",
    "typecheck": "npm run build && tsc -p tsconfig.test.json",
    "build": "node scripts/clean-dist.mts && tsc -p tsconfig.json",
    "prepack": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "typescript": "5.9.3",
    "@types/node": "24.19.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixcel/zixcel-webauthn.git"
  }
}
